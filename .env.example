# Development database (created by POSTGRES_DB in docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/billing

# Test database used by Vitest integration tests and Playwright e2e
# (created by docker/init-db.sql)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/billing_test

# Backups (scripts/backup.ts, scripts/restore-check.ts; see docs/ops/backup-restore.md)
# Run pg_dump/pg_restore inside the dev Docker container instead of using host tools:
# BACKUP_DOCKER_CONTAINER=billing-db
# Directory for dump files (default ./backups, git-ignored) and retention in days (default 30):
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=30
# Directory containing pg_dump/pg_restore when they are not on PATH:
# PG_BIN_DIR=
