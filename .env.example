# Required. PostgreSQL connection URL (postgres:// or postgresql://).
# Development database (created by POSTGRES_DB in docker-compose.yml).
# The app validates this at startup (src/lib/env.ts) and reports missing/invalid variables by name.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/billing

# NODE_ENV is optional and is normally set by the tooling: `next dev` = development,
# `next build` / `next start` = production, Vitest = test. Allowed values: development, test, production.
# Do not put it in .env. In production it enables the HSTS header and Secure session cookies.

# Test database used by Vitest integration tests and Playwright e2e
# (created by docker/init-db.sql)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/billing_test

# First-run owner account for `npm run seed` (see docs/ops/runbook.md). Use a throw-away
# password, change it in the app afterwards (Settings > Users > Change my password), then remove these.
# SEED_SHOP_NAME=My Shop
# SEED_OWNER_USERNAME=owner
# SEED_OWNER_PASSWORD=change-me-now

# Backups (scripts/backup.ts, scripts/restore-check.ts; see docs/ops/backup-restore.md)
# Run pg_dump/pg_restore inside the dev Docker container instead of using host tools:
# BACKUP_DOCKER_CONTAINER=billing-db
# Directory for dump files (default ./backups, git-ignored) and retention in days (default 30):
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=30
# Directory containing pg_dump/pg_restore when they are not on PATH:
# PG_BIN_DIR=
